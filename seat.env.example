# Copy to seat.env (gitignored) or export these before bin/tvd-guest / bin/tvd-doctor.
# Existing environment variables win over this file.
#
# Cursor is the default for this seat (fleet machine `cursor`).
GUEST_NICKNAME=Cursor
GUEST_COMPUTER=cursor
GUEST_USER=cursor
GUEST_SEAT_GUEST=0
#
# Grok guest profile (the original Grok Bot box) — only when that seat is selected:
# GUEST_NICKNAME=Grok
# GUEST_COMPUTER=grok-bot
# GUEST_USER=grok
# GUEST_SEAT_GUEST=1
